# =============================================================================
# TalentIA Environment Configuration
# =============================================================================

# Application Environment
# Set to 'development', 'testing', or 'production'
CI_ENVIRONMENT = development

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
database.default.hostname = localhost
database.default.username = postgres
database.default.password = your_postgresql_password
database.default.database = talentia
database.default.DBDriver = Postgre
database.default.DBPrefix = 
database.default.port = 5432
database.default.DBDebug = true

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
app.baseURL = http://localhost:8080/
app.indexPage = 
app.defaultLocale = en
app.appTimezone = UTC
app.charset = UTF-8

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
session.driver = CodeIgniter\Session\Handlers\FileHandler
session.savePath = WRITEPATH . 'session'
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false
session.cookieName = ci_session
session.cookieDomain = 
session.cookiePath = /
session.cookieSecure = false
session.cookieHTTPOnly = true
session.cookieSameSite = Lax
session.expiration = 7200

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

# -----------------------------------------------------------------------------
# Cookie Configuration
# -----------------------------------------------------------------------------
cookie.prefix = 
cookie.domain = 
cookie.path = /
cookie.secure = false
cookie.httponly = false
cookie.samesite = Lax
cookie.raw = false

# -----------------------------------------------------------------------------
# CSRF Protection
# -----------------------------------------------------------------------------
csrf.tokenName = csrf_test_name
csrf.headerName = X-CSRF-TOKEN
csrf.cookieName = csrf_cookie_name
csrf.expire = 7200
csrf.regenerate = true
csrf.excludeURIs = []

# -----------------------------------------------------------------------------
# Encryption Key
# IMPORTANT: Generate a new key for production!
# Run: php spark key:generate
encryption.key = 
encryption.driver = OpenSSL
encryption.digest = SHA512
encryption.rawData = false

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
logger.threshold = 4
logger.logQuery = false
logger.handler = CodeIgniter\Log\Handlers\FileHandler
logger.filename = log-%s.php
logger.filePermissions = 0644
logger.fileDateFormat = Y-m-d H:i:s
logger.fileExt = php
logger.filePath = WRITEPATH . 'logs/'
logger.cliLogs = true

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
cache.handler = file
cache.cachePath = WRITEPATH . 'cache/'
cache.includeQueryString = false
cache.cacheQueryString = false

# -----------------------------------------------------------------------------
# Email Configuration (if needed)
# -----------------------------------------------------------------------------
email.fromEmail = 
email.fromName = 
email.SMTPHost = 
email.SMTPUser = 
email.SMTPPass = 
email.SMTPPort = 25
email.SMTPTimeout = 5
email.SMTPKeepAlive = false
email.SMTPCrypto = 
email.mailType = html
email.charset = UTF-8
email.wordWrap = true

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
upload.directory = writable/uploads
upload.maxSize = 20480
upload.allowedTypes = gif,jpg,jpeg,png,pdf,doc,docx,txt
upload.removeSpaces = true
upload.encryptName = false

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Enable/disable debugging
database.tests.DBDriver = SQLite3
database.tests.database = :memory:

# Show errors in development
debug.displayErrors = 1
debug.errorReporting = E_ALL & ~E_DEPRECATED & ~E_STRICT

# -----------------------------------------------------------------------------
# Frontend Development Server (for React app)
# -----------------------------------------------------------------------------
# This is used by the React development server
VITE_API_URL = http://localhost:8080/api
VITE_APP_URL = http://localhost:5173
